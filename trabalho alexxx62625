import java.util.Scanner;

public class PesquisaOpiniao {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int idade;
        int total = 0, somaIdades = 0, opiniaoA = 0;

        System.out.println("===== PESQUISA DE OPINIÃO =====");

        while (true) {
            System.out.print("Digite a idade (idade negativa encerra): ");
            idade = sc.nextInt();

            if (idade < 0) {
                break;
            }

            sc.nextLine(); // Limpar buffer
            System.out.print("Digite a opinião (A-Ótimo, B-Bom, C-Regular, D-Ruim, E-Péssimo): ");
            char op = sc.nextLine().toUpperCase().charAt(0);

            if ("ABCDE".indexOf(op) != -1) {
                total++;
                somaIdades += idade;
                if (op == 'A') {
                    opiniaoA++;
                }
            } else {
                System.out.println("Opinião inválida. Tente novamente.");
            }
        }

        if (total > 0) {
            double media = (double) somaIdades / total;
            double percentualA = (double) opiniaoA / total * 100;

            System.out.println("\n=== RESULTADOS ===");
            System.out.println("Total de pessoas: " + total);
            System.out.printf("Média de idades: %.2f\n", media);
            System.out.printf("Porcentagem de respostas 'A': %.2f%%\n", percentualA);
        } else {
            System.out.println("Nenhum dado foi inserido.");
        }

        sc.close();
    }
}
