import java.util.Scanner;

public class CalculoSalario {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String resposta;

        System.out.println("===== CÁLCULO DE SALÁRIO =====");

        do {
            System.out.print("Horas trabalhadas: ");
            double ht = sc.nextDouble();

            System.out.print("Valor por hora: ");
            double vh = sc.nextDouble();

            double salarioBruto = ht * vh;
            double inss = salarioBruto * 0.11;
            double baseIR = salarioBruto - inss;
            double impostoRenda = 0;

            if (baseIR > 1800) {
                impostoRenda = baseIR * 0.275 - 360;
            } else if (baseIR > 900) {
                impostoRenda = baseIR * 0.15 - 135;
            }

            double salarioLiquido = salarioBruto - inss - impostoRenda;

            System.out.printf("Salário líquido: R$ %.2f\n", salarioLiquido);

            sc.nextLine(); // Limpar buffer
            do {
                System.out.print("Deseja calcular o salário de outro funcionário? (S/N): ");
                resposta = sc.nextLine().toUpperCase();
            } while (!resposta.equals("S") && !resposta.equals("N"));

        } while (resposta.equals("S"));

        sc.close();
    }
}
