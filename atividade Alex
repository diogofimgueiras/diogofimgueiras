// PROGRAMA PARA ACIONAR UM LED COM O BOTÃO

// Definição dos pinos dos LEDs
int LEDLAR1 = 8;  // Led 1 (laranja) no pino 8
int LEDAZU2 = 9;  // Led 2 (azul) no pino 9
int LEDAMA3 = 10; // Led 3 (amarelo) no pino 10

// Definição dos pinos dos botões
int BOT1 = 7;     // Botão 1 no pino 7
int BOT2 = 6;     // Botão 2 no pino 6
int BOT3 = 5;     // Botão 3 no pino 5

// Variáveis para armazenar o estado dos botões
int ESTBOT1 = 0;
int ESTBOT2 = 0;
int ESTBOT3 = 0;

void setup() {
  // Configuração dos pinos dos LEDs como saída
  pinMode(LEDLAR1, OUTPUT);
  pinMode(LEDAZU2, OUTPUT);
  pinMode(LEDAMA3, OUTPUT);

  // Configuração dos pinos dos botões como entrada
  pinMode(BOT1, INPUT);
  pinMode(BOT2, INPUT);
  pinMode(BOT3, INPUT);
}

void loop() {
  // Leitura do estado dos botões
  ESTBOT1 = digitalRead(BOT1);
  ESTBOT2 = digitalRead(BOT2);
  ESTBOT3 = digitalRead(BOT3);

  // Verifica se o botão 1 foi pressionado
  if (ESTBOT1 == HIGH) {
    digitalWrite(LEDLAR1, HIGH);   // Acende o LED 1
    digitalWrite(LEDAZU2, LOW);    // Apaga o LED 2
    digitalWrite(LEDAMA3, LOW);    // Apaga o LED 3
  }

  // Verifica se o botão 2 foi pressionado
  else if (ESTBOT2 == HIGH) {
    digitalWrite(LEDLAR1, LOW);    // Apaga o LED 1
    digitalWrite(LEDAZU2, HIGH);   // Acende o LED 2
    digitalWrite(LEDAMA3, LOW);    // Apaga o LED 3
  }

  // Verifica se o botão 3 foi pressionado
  else if (ESTBOT3 == HIGH) {
    digitalWrite(LEDLAR1, LOW);    // Apaga o LED 1
    digitalWrite(LEDAZU2, LOW);    // Apaga o LED 2
    digitalWrite(LEDAMA3, HIGH);   // Acende o LED 3
  }

  delay(100); // Pequeno atraso para evitar leituras instáveis
}
