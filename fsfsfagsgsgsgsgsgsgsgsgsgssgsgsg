// C++ code
//

int LEDAZUL = 9;
int LEDAMAR = 10;
int LEDVERDE = 8;
int LEDLAR = 11;
int BOTAOAZUL = 6;
int BOTAOAMAR = 5;
int BOTAOVERDE = 7;
int BOTAOLAR = 4;
int BOTAORESET = 3;
int ESTAAZUL = 0;
int ESTAAMAR = 0;
int ESTAVERDE = 0;
int ESTALAR = 0;
int RESET = 0;

void setup()
{
  pinMode(LEDAZUL, OUTPUT);
  pinMode(BOTAOAZUL, INPUT);
  pinMode(LEDAMAR, OUTPUT);
  pinMode(BOTAOAMAR, INPUT);
  pinMode(LEDVERDE, OUTPUT);
  pinMode(BOTAOVERDE, INPUT);
  pinMode(LEDLAR, OUTPUT);
  pinMode(BOTAOLAR, INPUT);
  pinMode(BOTAORESET, INPUT);
}

void loop()
{
  ESTAAZUL = digitalRead(BOTAOAZUL);
  ESTAAMAR = digitalRead(BOTAOAMAR);
  ESTAVERDE = digitalRead(BOTAOVERDE);
  ESTALAR = digitalRead(BOTAOLAR);
  RESET = digitalRead(BOTAORESET);
  
  
  if (ESTAAZUL == HIGH){
    digitalWrite(LEDAZUL, HIGH);
    digitalWrite(LEDVERDE, HIGH);
  }
    if (ESTAAMAR == HIGH){
    digitalWrite(LEDAZUL, HIGH);
    digitalWrite(LEDAMAR, HIGH);
    digitalWrite(LEDVERDE, HIGH);
  }
    if (ESTAVERDE == HIGH){
    digitalWrite(LEDVERDE, HIGH);
  }
      if (ESTALAR == HIGH){
    digitalWrite(LEDAZUL, HIGH);
    digitalWrite(LEDAMAR, HIGH);
    digitalWrite(LEDVERDE, HIGH);
    digitalWrite(LEDLAR, HIGH);
  }
  if (RESET == HIGH){
    digitalWrite(LEDAZUL, LOW);
    digitalWrite(LEDAMAR, LOW);
    digitalWrite(LEDVERDE, LOW);
    digitalWrite(LEDLAR, LOW);
  }
  
}
